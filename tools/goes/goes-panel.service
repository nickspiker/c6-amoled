[Unit]
Description=GOES-18 satellite loop on the c6-amoled panel
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/Harbor/Code

[Service]
WorkingDirectory=/mnt/Harbor/Code/c6-amoled/tools/goes
ExecStart=/mnt/Harbor/Code/c6-amoled/tools/goes/.venv/bin/python -u client.py loop
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
