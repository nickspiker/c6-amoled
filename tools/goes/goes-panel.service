[Unit]
Description=GOES-18 satellite loop on the c6-amoled panel
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/Harbor/Code

[Service]
# Started through /usr/bin/env: /mnt/Harbor carries no SELinux labels, and systemd may only start labelled executables; env (bin_t) then runs the binary, as python3 once ran the scripts.
User=nick
WorkingDirectory=/mnt/Harbor/Code/c6-amoled/tools/goes
ExecStart=/usr/bin/env /mnt/Harbor/Code/c6-amoled/tools/goes/target/x86_64-unknown-linux-gnu/release/goes loop
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
